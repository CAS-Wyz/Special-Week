server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # Redirige les appels /api/ vers le backend
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Désactive le cache pour JS et CSS
    location ~* \.(js|css)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache, must-revalidate";
        expires 0;
    }

    # Sert les fichiers statiques, fallback sur accueil.html
    location / {
        try_files $uri $uri/ /Accueil/accueil.html;
    }
}
