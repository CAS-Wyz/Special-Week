server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # ── Headers de sécurité ────────────────────────────────────────────────
    # Empêche le clickjacking
    add_header X-Frame-Options "DENY" always;
    # Empêche le MIME sniffing
    add_header X-Content-Type-Options "nosniff" always;
    # Active le filtre XSS des anciens navigateurs
    add_header X-XSS-Protection "1; mode=block" always;
    # Limite les infos envoyées dans le Referer
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # HSTS : force HTTPS pendant 1 an (activé si derrière HTTPS Azure)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # CSP : autorise uniquement les ressources connues
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: api.qrserver.com; connect-src 'self'; font-src 'self'; frame-ancestors 'none'" always;

    # ── Proxy vers le backend ──────────────────────────────────────────────
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # ── Désactive le cache pour JS et CSS ─────────────────────────────────
    location ~* \.(js|css)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache, must-revalidate";
        expires 0;
    }

    # ── Fichiers statiques, fallback sur accueil.html ──────────────────────
    location / {
        try_files $uri $uri/ /Accueil/accueil.html;
    }
}
